<rc:RcWindow xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rc="using:RemoteControl.Ui.Common"
             x:Class="RemoteControl.Ui.Players.AccountEditorWindow"
             Width="300" Height="350" CanResize="False">
  <rc:RcWindow.Styles>
    <StyleInclude Source="avares://RemoteControl.Ui.Players/Compact.axaml" />
  </rc:RcWindow.Styles>
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="5">
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.8" />
      <Button x:Name="ApplyButton" Content="Apply" MinWidth="70" HorizontalContentAlignment="Center" Classes="accent" />
      <Button x:Name="CloseButton" Content="Close" MinWidth="70" HorizontalContentAlignment="Center" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Text="Account attributes" FontWeight="SemiBold" Margin="14,8,14,0" />
    <Grid Margin="14,6,14,0" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="5" RowSpacing="3">
      <TextBlock Grid.Row="0" Text="Account name:" VerticalAlignment="Center" />
      <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" />
      <TextBlock Grid.Row="1" Text="Password:" VerticalAlignment="Center" />
      <TextBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" PasswordChar="•" />
      <TextBlock Grid.Row="2" Text="E-mail address:" VerticalAlignment="Center" />
      <TextBox x:Name="EmailBox" Grid.Row="2" Grid.Column="1" />
      <TextBlock Grid.Row="3" Text="Admin level:" VerticalAlignment="Center" />
      <TextBox x:Name="LevelBox" Grid.Row="3" Grid.Column="1" Text="0" />
      <TextBlock Grid.Row="4" Text="Admin worlds:" VerticalAlignment="Center" />
      <TextBox x:Name="WorldsBox" Grid.Row="4" Grid.Column="1" Text="all" />
      <CheckBox x:Name="BannedCheck" Grid.Row="5" Content="Banned" />
      <CheckBox x:Name="GuestCheck" Grid.Row="5" Grid.Column="1" Content="Guest" />
      <TextBlock Grid.Row="6" Text="Ban-Time:" VerticalAlignment="Center" />
      <TextBox x:Name="BanTimeBox" Grid.Row="6" Grid.Column="1" IsReadOnly="True" />
      <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="Ban-Reason / Comments:" />
      <TextBox x:Name="ReasonBox" Grid.Row="8" Grid.ColumnSpan="2" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52"
               VerticalContentAlignment="Top" Background="{DynamicResource RcEditorBrush}" />
    </Grid>
  </DockPanel>
</rc:RcWindow>
