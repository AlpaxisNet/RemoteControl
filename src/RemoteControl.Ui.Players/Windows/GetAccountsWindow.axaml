<rc:RcWindow xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rc="using:RemoteControl.Ui.Common"
             x:Class="RemoteControl.Ui.Players.GetAccountsWindow"
             Width="400" Height="250" MinWidth="340" MinHeight="230">
  <rc:RcWindow.Styles>
    <StyleInclude Source="avares://RemoteControl.Ui.Players/Compact.axaml" />
  </rc:RcWindow.Styles>
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="5">
      <Button x:Name="GetListButton" Content="Get List" MinWidth="80" HorizontalContentAlignment="Center" Classes="accent" />
      <Button x:Name="CloseButton" Content="Close" MinWidth="80" HorizontalContentAlignment="Center" />
    </StackPanel>
    <Border Margin="5" BorderThickness="1" BorderBrush="{DynamicResource RcBorderBrush}" CornerRadius="4" Padding="8">
      <StackPanel Spacing="4">
        <TextBlock Text=" Account specification " FontWeight="SemiBold" />
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="5" RowSpacing="2">
          <TextBlock Text="Account name spec:" VerticalAlignment="Center" />
          <TextBox x:Name="SpecBox" Grid.Column="1" />
          <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Text="example: Stef%" Opacity="0.75" />
          <TextBlock Grid.Row="2" Text="Conditions:" VerticalAlignment="Center" />
          <TextBox x:Name="ConditionsBox" Grid.Row="2" Grid.Column="1" />
          <TextBlock Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" Text="example: adminlevel&gt;0" Opacity="0.75" />
        </Grid>
        <TextBlock TextWrapping="Wrap" Text="Variables usage examples: email='xxx', adminlevel=1, adminworlds like '%all%', blocked=1" />
      </StackPanel>
    </Border>
  </DockPanel>
</rc:RcWindow>
