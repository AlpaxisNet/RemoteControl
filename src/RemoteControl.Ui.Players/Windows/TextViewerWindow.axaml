<rc:RcWindow xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rc="using:RemoteControl.Ui.Common"
             x:Class="RemoteControl.Ui.Players.TextViewerWindow"
             Width="440" Height="300" MinWidth="240" MinHeight="140">
  <rc:RcWindow.Styles>
    <StyleInclude Source="avares://RemoteControl.Ui.Players/Compact.axaml" />
  </rc:RcWindow.Styles>
  <DockPanel Margin="5">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,5,0,0" LastChildFill="False">
      <TextBlock x:Name="LineStatus" DockPanel.Dock="Left" VerticalAlignment="Center" Opacity="0.8" Text="Line 1, Column 1" />
      <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" MinWidth="76" Margin="5,0,0,0" />
      <Button x:Name="FindButton" DockPanel.Dock="Right" Content="Find" MinWidth="76" ToolTip.Tip="Find (Ctrl+F)" />
    </DockPanel>
    <Border BorderThickness="1" BorderBrush="{DynamicResource RcBorderBrush}">
      <ContentControl x:Name="EditorHost" />
    </Border>
  </DockPanel>
</rc:RcWindow>
