<rc:RcWindow xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rc="using:RemoteControl.Ui.Common"
             x:Class="RemoteControl.Ui.Players.CommentsWindow"
             Width="420" Height="280" MinWidth="260" MinHeight="160">
  <rc:RcWindow.Styles>
    <StyleInclude Source="avares://RemoteControl.Ui.Players/Compact.axaml" />
  </rc:RcWindow.Styles>
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="5">
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.8" />
      <Button x:Name="CloseButton" Content="Close" MinWidth="76" HorizontalContentAlignment="Center" />
      <Button x:Name="SaveButton" Content="Save" MinWidth="76" HorizontalContentAlignment="Center" Classes="accent" />
    </StackPanel>
    <TextBox x:Name="CommentsBox" Margin="5,5,5,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
  </DockPanel>
</rc:RcWindow>
