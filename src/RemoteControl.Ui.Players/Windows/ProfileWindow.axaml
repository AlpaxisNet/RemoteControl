<rc:RcWindow xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rc="using:RemoteControl.Ui.Common"
             x:Class="RemoteControl.Ui.Players.ProfileWindow"
             Width="520" Height="400" MinWidth="480" MinHeight="340">
  <rc:RcWindow.Styles>
    <StyleInclude Source="avares://RemoteControl.Ui.Players/Compact.axaml" />
  </rc:RcWindow.Styles>
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="5">
      <Button x:Name="ApplyButton" Content="Apply" MinWidth="76" HorizontalContentAlignment="Center" Classes="accent" />
      <Button x:Name="CloseButton" Content="Close" MinWidth="76" HorizontalContentAlignment="Center" />
    </StackPanel>
    <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" Margin="10,6,10,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
    <Grid ColumnDefinitions="*,Auto" Margin="10" ColumnSpacing="20">
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Player information" FontWeight="SemiBold" Margin="0,0,0,5" />
        <Grid x:Name="InfoGrid" DockPanel.Dock="Top" ColumnDefinitions="94,*" RowSpacing="3" ColumnSpacing="6" />
        <TextBlock DockPanel.Dock="Top" Text="Favourite quote:" Margin="0,8,0,4" />
        <TextBox x:Name="QuoteBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" VerticalContentAlignment="Top" />
      </DockPanel>
      <DockPanel Grid.Column="1" Width="200">
        <TextBlock DockPanel.Dock="Top" Text="In-game stats" FontWeight="SemiBold" Margin="0,0,0,5" />
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="3" ColumnSpacing="5">
          <TextBlock Text="Level:" VerticalAlignment="Center" />
          <TextBox x:Name="LevelBox" Grid.Column="1" IsReadOnly="True" />
          <TextBlock Grid.Row="1" Text="Online time:" VerticalAlignment="Center" />
          <TextBox x:Name="OnlineBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" />
        </Grid>
        <Border BorderThickness="1" BorderBrush="{DynamicResource RcBorderBrush}" Margin="0,4,0,0">
          <ScrollViewer>
            <ItemsControl x:Name="StatsList" Margin="4" />
          </ScrollViewer>
        </Border>
      </DockPanel>
    </Grid>
  </DockPanel>
</rc:RcWindow>
