<rc:RcWindow xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rc="using:RemoteControl.Ui.Common"
             x:Class="RemoteControl.Ui.Players.RightsWindow"
             Width="460" Height="420" MinWidth="420" MinHeight="300">
  <rc:RcWindow.Styles>
    <StyleInclude Source="avares://RemoteControl.Ui.Players/Compact.axaml" />
  </rc:RcWindow.Styles>
  <DockPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="5">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
        <Button x:Name="CloseButton" Content="Close" MinWidth="70" HorizontalContentAlignment="Center" />
        <Button x:Name="ApplyButton" Content="Apply" MinWidth="70" HorizontalContentAlignment="Center" Classes="accent" />
      </StackPanel>
      <StackPanel x:Name="Presets" Orientation="Horizontal" Spacing="3">
        <Button x:Name="ClearAllButton" Content="Clear all" />
      </StackPanel>
    </DockPanel>
    <TabControl Margin="5" Padding="0">
      <TabItem Header="IP Range and Right flags">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="5" Spacing="3">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4">
              <TextBlock Text="Account name:" VerticalAlignment="Center" />
              <TextBox x:Name="AccountBox" Grid.Column="1" IsReadOnly="True" />
              <TextBlock Grid.Row="1" Text="IP range(s):" VerticalAlignment="Center" />
              <TextBox x:Name="IpRangeBox" Grid.Row="1" Grid.Column="1" />
            </Grid>
            <Grid x:Name="RightsGrid" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Folder rights">
        <TextBox x:Name="FoldersBox" Margin="5" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                 FontFamily="{DynamicResource RcScriptFontFamily}" />
      </TabItem>
    </TabControl>
  </DockPanel>
</rc:RcWindow>
