<common:RcWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:common="using:RemoteControl.Ui.Common"
                 xmlns:local="using:RemoteControl.Ui.Session"
                 x:Class="RemoteControl.Ui.Session.OptionsWindow"
                 Title="Options"
                 Width="460" Height="520" MinWidth="380" MinHeight="320"
                 Background="{DynamicResource RcBackgroundBrush}">
  <common:RcWindow.Styles>
    <Style Selector="TabControl#OptionTabs TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="9,3" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="CheckBox /template/ ContentPresenter">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,8,0,2" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Grid.form > TextBox, Grid.form > ComboBox, Grid.form > NumericUpDown">
      <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style Selector="Grid.form > Button">
      <Setter Property="Margin" Value="6,2,0,2" />
    </Style>
    <Style Selector="TextBox, ComboBox, NumericUpDown, Button">
      <Setter Property="FontSize" Value="12" />
    </Style>
  </common:RcWindow.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="6">
      <Button Name="CloseButton" Content="Close" HorizontalAlignment="Right" MinWidth="80" HorizontalContentAlignment="Center" />
    </Border>
    <TabControl Name="OptionTabs" Margin="5,5,5,0" Padding="0">

      <TabItem Header="General" Name="GeneralTab">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="6" Spacing="4">
            <UniformGrid Columns="2">
              <CheckBox Name="nomassmessages" Content="Ignore Mass PMs" />
              <CheckBox Name="nomassifclienton" Content="Ignore Mass PMs if client is on" />
              <CheckBox Name="attachaway" Content="Go in away mode when closing playerlist" />
              <CheckBox Name="globalpms" Content="Allow Global PMs" />
              <CheckBox Name="buddytracking" Content="Show yourself on other buddy lists" />
              <CheckBox Name="separatenc" Content="Separate NC from RC Chat" />
              <CheckBox Name="rctimestamps" Content="Timestamp RC Messages" />
              <CheckBox Name="newpmalerts" Content="Show new PM Alerts in RC Chat" />
              <CheckBox Name="notificationsounds" Content="Play sounds for alerts and PMs" />
              <CheckBox Name="separatefindresults" Content="Separate find results tabs" />
              <CheckBox Name="afkenabled" Content="Set nickname to Away when inactive" />
              <CheckBox Name="modernfilebrowser" Content="Modern File Browser" />
              <CheckBox Name="filebrowserhoverpreview" Content="File Browser hover previews" />
              <CheckBox Name="filebrowserthumbnails" Content="Modern File Browser thumbnails (Experimental)" />
              <CheckBox Name="extensionsenabled" Content="Extensions" />
              <CheckBox Name="syncenabled" Content="Sync &amp; Git Backups" />
              <CheckBox Name="levellistenabled" Content="Level List (Legacy)" />
              <CheckBox Name="usenewbantype" Content="Use new ban type" />
              <CheckBox Name="autoreconnectnc" Content="Auto reconnect NC" />
            </UniformGrid>
            <Grid Classes="form" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,6,0,0">
              <TextBlock Classes="label" Text="Nickname:" />
              <TextBox Grid.Column="1" Grid.ColumnSpan="2" Name="nickname" />
              <TextBlock Classes="label" Grid.Row="1" Text="Chat font:" />
              <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,2">
                <ComboBox Name="chatfontfamily" HorizontalAlignment="Stretch" MaxDropDownHeight="300" />
                <NumericUpDown Grid.Column="1" Name="chatfontsize" Minimum="1" Maximum="1000" Increment="1" FormatString="0" Width="104" Margin="6,0,0,0" />
              </Grid>
              <TextBlock Classes="label" Grid.Row="2" Text="Away timeout:" />
              <ComboBox Grid.Row="2" Grid.Column="1" Name="afktimeout" MinWidth="140" />
              <TextBlock Classes="label" Grid.Row="3" Text="Global show/hide hotkey:" />
              <TextBox Grid.Row="3" Grid.Column="1" Name="globalhotkey" IsReadOnly="True" Watermark="Focus and press a key combination"
                       ToolTip.Tip="Focus and press a key combination" />
              <Button Grid.Row="3" Grid.Column="2" Name="HotkeyOk" Content="OK" ToolTip.Tip="Save global show/hide hotkey" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Files" Name="FilesTab">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <Grid Classes="form" Margin="6" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <TextBlock Classes="label" Text="Download folder:" />
            <TextBox Grid.Column="1" Name="downloadfolder" />
            <Button Grid.Column="2" Name="BrowseDownload" Content="Browse" />
            <CheckBox Grid.Row="1" Name="logrcchat" Content="Log RC Chat" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Name="chatlogfile" />
            <Button Grid.Row="1" Grid.Column="2" Name="BrowseLog" Content="Browse" />
            <TextBlock Classes="label" Grid.Row="2" Text="External workspace:" />
            <TextBox Grid.Row="2" Grid.Column="1" Name="externaleditorworkspace" />
            <Button Grid.Row="2" Grid.Column="2" Name="BrowseWorkspace" Content="Browse" />
            <TextBlock Classes="label" Grid.Row="3" Text="External editor command:" />
            <TextBox Grid.Row="3" Grid.Column="1" Name="externaleditorcommand" />
            <Button Grid.Row="3" Grid.Column="2" Name="BrowseEditor" Content="Browse" />
            <TextBlock Classes="label" Grid.Row="4" Text="External editor mode:" />
            <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Name="externaleditorscope" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="Disabled" Tag="off" />
              <ComboBoxItem Content="Scripts only" Tag="scripts" />
              <ComboBoxItem Content="Scripts + RC text editors" Tag="text" />
            </ComboBox>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Script" Name="ScriptTab">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="6" Spacing="4">
            <UniformGrid Columns="2">
              <CheckBox Name="syntaxhighlighting" Content="Syntax highlighting" />
              <CheckBox Name="autoindenting" Content="Auto indenting" />
              <CheckBox Name="smarthomeend" Content="Smart Home/End" />
              <CheckBox Name="showbrackets" Content="Show brackets" />
              <CheckBox Name="showlinenumbers" Content="Show line numbers" />
              <CheckBox Name="minimap" Content="Show minimap (WIP)" />
              <CheckBox Name="lsp" Content="LSP / autocomplete" />
              <CheckBox Name="scriptdiagnostics" Content="Script analysis" />
              <CheckBox Name="scriptusetabs" Content="Use real tabs for indentation" />
            </UniformGrid>
            <Grid Classes="form" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,6,0,0">
              <TextBlock Classes="label" Text="Script tab width:" />
              <NumericUpDown Grid.Column="1" Name="scripttabwidth" Minimum="1" Maximum="1000" Increment="1" FormatString="0" HorizontalAlignment="Left" Width="120" />
              <TextBlock Classes="label" Grid.Row="1" Text="Script font:" />
              <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,2">
                <ComboBox Name="scriptfontfamily" HorizontalAlignment="Stretch" MaxDropDownHeight="300" />
                <NumericUpDown Grid.Column="1" Name="scriptfontsize" Minimum="1" Maximum="1000" Increment="1" FormatString="0" Width="104" Margin="6,0,0,0" />
              </Grid>
              <TextBlock Classes="label" Grid.Row="2" Text="Autocomplete source:" />
              <TextBox Grid.Row="2" Grid.Column="1" Name="autocompletesource" />
              <Button Grid.Row="2" Grid.Column="2" Name="BrowseAutocomplete" Content="Browse" />
              <TextBlock Classes="label" Grid.Row="3" Text="Syntax theme:" />
              <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Name="syntaxtheme" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Language spec" Tag="language-spec" />
                <ComboBoxItem Content="Dracula" Tag="dracula" />
                <ComboBoxItem Content="Material" Tag="material" />
                <ComboBoxItem Content="Ayu Mirage" Tag="ayu-mirage" />
                <ComboBoxItem Content="Nord" Tag="nord" />
                <ComboBoxItem Content="Monokai" Tag="monokai" />
                <ComboBoxItem Content="One Dark" Tag="one-dark" />
                <ComboBoxItem Content="Tokyo Night" Tag="tokyo-night" />
                <ComboBoxItem Content="Gruvbox" Tag="gruvbox" />
                <ComboBoxItem Content="Solarized Dark" Tag="solarized" />
                <ComboBoxItem Content="Catppuccin Mocha" Tag="catppuccin" />
                <ComboBoxItem Content="Light" Tag="light" />
              </ComboBox>
              <CheckBox Grid.Row="4" Grid.ColumnSpan="3" Name="syncsyntaxtheme" Content="Sync syntax theme with UI theme" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Format" Name="FormatTab">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="6" Spacing="4">
            <Grid Classes="form" ColumnDefinitions="Auto,*">
              <TextBlock Classes="label" Text="Indent width:" />
              <NumericUpDown Grid.Column="1" Name="formatindentwidth" Minimum="1" Maximum="16" Increment="1" FormatString="0" HorizontalAlignment="Left" Width="120" />
            </Grid>
            <UniformGrid Columns="2">
              <CheckBox Name="formatusetabs" Content="Use tabs when formatting" />
              <CheckBox Name="formattrimtrailing" Content="Trim trailing whitespace when formatting" />
              <CheckBox Name="removelinecomments" Content="Remove line comments" />
              <CheckBox Name="removeblockcomments" Content="Remove block comments" />
              <CheckBox Name="preserveclientside" Content="Preserve standalone //#CLIENTSIDE" />
            </UniformGrid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Custom" Name="CustomTab">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="6" Spacing="2">
            <Grid Classes="form" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Classes="label" Text="Chatbar text color:" />
              <local:ColorField Grid.Column="1" Name="coloredit" Margin="0,2" />
              <TextBlock Classes="label" Grid.Row="1" Text="Chatbar background color:" />
              <local:ColorField Grid.Row="1" Grid.Column="1" Name="coloreditback" Margin="0,2" />
              <TextBlock Classes="label" Grid.Row="2" Text="Chat text color:" />
              <local:ColorField Grid.Row="2" Grid.Column="1" Name="colorchat" Margin="0,2" />
              <TextBlock Classes="label" Grid.Row="3" Text="Chat bold color:" />
              <local:ColorField Grid.Row="3" Grid.Column="1" Name="colorchatbold" Margin="0,2" />
              <TextBlock Classes="label" Grid.Row="4" Text="Chat background color:" />
              <local:ColorField Grid.Row="4" Grid.Column="1" Name="colorchatback" Margin="0,2" />
              <TextBlock Classes="label" Grid.Row="5" Text="Label color:" />
              <local:ColorField Grid.Row="5" Grid.Column="1" Name="colorlabel" Margin="0,2" />
              <TextBlock Classes="label" Grid.Row="6" Text="Label background color:" />
              <local:ColorField Grid.Row="6" Grid.Column="1" Name="colorlabelback" Margin="0,2" />
              <TextBlock Classes="label" Grid.Row="7" Text="Server label:" />
              <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Name="labelservers" />
              <TextBlock Classes="label" Grid.Row="8" Text="Players label:" />
              <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Name="labelplayers" />
              <TextBlock Classes="label" Grid.Row="9" Text="NPC server label:" />
              <TextBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Name="labelnpcserver" />
              <TextBlock Classes="label" Grid.Row="10" Text="Background image:" />
              <TextBox Grid.Row="10" Grid.Column="1" Name="background" />
              <Button Grid.Row="10" Grid.Column="2" Name="BrowseBackground" Content="Browse" />
              <TextBlock Classes="label" Grid.Row="11" Text="Background image tint:" />
              <local:ColorField Grid.Row="11" Grid.Column="1" Name="backgroundtint" AllowAlpha="True" Margin="0,2" />
              <CheckBox Grid.Row="11" Grid.Column="2" Name="backgroundtintsolid" Content="Solid fill" Margin="6,0,0,0" VerticalAlignment="Center" />
              <TextBlock Classes="label" Grid.Row="12" Text="Theme:" />
              <ComboBox Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" Name="theme" HorizontalAlignment="Stretch" />
              <CheckBox Grid.Row="13" Grid.ColumnSpan="3" Name="syncbackgroundtint" Content="Sync background tint with theme" />
            </Grid>
            <UniformGrid Columns="2">
              <CheckBox Name="synccolors" Content="Sync colors with theme" />
              <CheckBox Name="roundedcorners" Content="Rounded app corners" />
            </UniformGrid>
            <TextBlock Classes="section" Text="Header button pictures" />
            <Grid Classes="form" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
              <TextBlock Classes="label" Text="Button:" />
              <ComboBox Grid.Column="1" Grid.ColumnSpan="3" Name="ButtonPicker" HorizontalAlignment="Stretch" />
              <TextBlock Classes="label" Grid.Row="1" Text="Picture:" />
              <TextBox Grid.Row="1" Grid.Column="1" Name="ButtonNormal" />
              <Image Grid.Row="1" Grid.Column="2" Name="ButtonNormalPreview" Width="28" Height="28" Margin="6,0,0,0" />
              <Button Grid.Row="1" Grid.Column="3" Name="BrowseButtonNormal" Content="Browse" />
              <TextBlock Classes="label" Grid.Row="2" Text="Pressed picture:" />
              <TextBox Grid.Row="2" Grid.Column="1" Name="ButtonPressed" />
              <Image Grid.Row="2" Grid.Column="2" Name="ButtonPressedPreview" Width="28" Height="28" Margin="6,0,0,0" />
              <Button Grid.Row="2" Grid.Column="3" Name="BrowseButtonPressed" Content="Browse" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="MCP" Name="McpTab">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="6" Spacing="4">
            <UniformGrid Columns="2">
              <CheckBox Name="mcpenabled" Content="Enable local MCP integration" />
              <CheckBox Name="mcpread" Content="Allow read-only tools" />
              <CheckBox Name="mcpwrite" Content="Allow file and script writes" />
              <CheckBox Name="mcpserver" Content="Allow server and game mutations" />
              <CheckBox Name="mcplogin" Content="Allow login and connection control" />
              <CheckBox Name="mcpwindows" Content="Allow window and UI control" />
              <CheckBox Name="mcpadmin" Content="Allow administrative actions" />
              <CheckBox Name="mcpfullcontrol" Content="Full native RC control" />
              <CheckBox Name="mcpapprove" Content="Require approval for mutations" />
              <CheckBox Name="mcpaudit" Content="Write MCP audit log" />
            </UniformGrid>
            <CheckBox Name="mcpbypass" Content="Bypass all MCP permissions (every tool allowed, nothing asked)" />
            <TextBlock Classes="label" TextWrapping="Wrap"
                       Text="With the bypass on, MCP clients may change anything on every connected server without a question; backups, the audit log, the file roots and the server scope still apply. A headless program (RemoteControl --headless) needs it, or approvals off, since no one is there to answer." />
            <Border BorderThickness="1" BorderBrush="{DynamicResource RcBorderBrush}" CornerRadius="3" Padding="6" Margin="0,4">
              <StackPanel Spacing="2">
                <TextBlock Classes="section" Margin="0" Text="Saved script approvals" />
                <CheckBox Name="mcpapproveweapon" Content="Allow Weapon script edits and saves without prompting" />
                <CheckBox Name="mcpapproveclass" Content="Allow Class script edits and saves without prompting" />
                <CheckBox Name="mcpapprovenpc" Content="Allow NPC script edits and saves without prompting" />
                <Button Name="ResetApprovals" Content="Reset saved script approvals" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
              <TextBlock Classes="label" Text="Allowed file roots:" />
              <TextBox Grid.Column="1" Name="mcpfileroots" />
              <TextBlock Classes="label" Grid.Row="1" Text="Allowed server scope:" />
              <TextBox Grid.Row="1" Grid.Column="1" Name="mcpserverscope" />
              <TextBlock Classes="label" Grid.Row="2" Text="More GS2 reference folders:" />
              <TextBox Grid.Row="2" Grid.Column="1" Name="mcpreferencefolders" />
            </Grid>
            <TextBlock Name="McpFolders" Classes="label" TextWrapping="Wrap" />
            <TextBlock Classes="label" Text="Stdio client launch command:" />
            <TextBox Name="McpLaunch" IsReadOnly="True" />
            <TextBlock Classes="label" TextWrapping="Wrap" Text="Stdio is local process-to-process communication; RC does not open a TCP listener." />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Name="ViewAudit" Content="View audit log" />
              <Button Name="ClearAudit" Content="Clear audit log" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</common:RcWindow>
