<rc:RcWindow xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rc="using:RemoteControl.Ui.Common"
             xmlns:local="using:RemoteControl.Ui.Files"
             x:Class="RemoteControl.Ui.Files.FileBrowserWindow"
             Title="File Browser" Width="800" Height="600" MinWidth="480" MinHeight="320">
  <rc:RcWindow.Resources>
    <StreamGeometry x:Key="FolderClosedGeometry">M1,3 L6,3 L8,5 L15,5 L15,14 L1,14 Z</StreamGeometry>
    <StreamGeometry x:Key="FolderOpenGeometry">M1,3 L6,3 L8,5 L14,5 L14,7 L4,7 L1,14 Z M4.5,8 L16,8 L13,14 L1.5,14 Z</StreamGeometry>
    <StreamGeometry x:Key="UpGeometry">M8,2 L14,8 L10,8 L10,14 L6,14 L6,8 L2,8 Z</StreamGeometry>
    <StreamGeometry x:Key="RefreshGeometry">M13,8 A5,5 0 1 1 8,3 L8,1 L12,4 L8,7 L8,5 A3,3 0 1 0 11,8 Z</StreamGeometry>
  </rc:RcWindow.Resources>
  <rc:RcWindow.Styles>
    <Style Selector="ListBox#FileList ListBoxItem">
      <Setter Property="Padding" Value="2,1" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox#ModernView ListBoxItem">
      <Setter Property="Padding" Value="5" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="Width" Value="112" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="TreeView#FolderTree TreeViewItem" x:DataType="local:FolderNode">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource RcBorderBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.tool PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
  </rc:RcWindow.Styles>
  <DockPanel Margin="5">
    <DockPanel DockPanel.Dock="Bottom" Margin="5,5,5,0">
      <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" MinWidth="80" HorizontalContentAlignment="Center" />
      <TextBlock x:Name="StatusLabel" Text="0 files" VerticalAlignment="Center" />
    </DockPanel>
    <Border BorderBrush="{DynamicResource RcBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource RcControlCornerRadius}" Padding="5" Margin="5">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Files" FontWeight="SemiBold" Margin="2,0,0,4" />
        <Panel DockPanel.Dock="Top" Margin="0,0,0,5">
          <TextBlock x:Name="FolderLabel" Text="Current Folder:" VerticalAlignment="Center" Margin="2,4" />
          <DockPanel x:Name="AddressRow" IsVisible="False">
            <TextBlock DockPanel.Dock="Left" Text="Address:" VerticalAlignment="Center" Margin="2,0,6,0" />
            <Button x:Name="RefreshButton" Classes="tool" DockPanel.Dock="Right" Margin="4,0,0,0" ToolTip.Tip="Refresh folder">
              <PathIcon Data="{StaticResource RefreshGeometry}" />
            </Button>
            <Button x:Name="UpButton" Classes="tool" DockPanel.Dock="Right" Margin="4,0,0,0" ToolTip.Tip="Parent folder">
              <PathIcon Data="{StaticResource UpGeometry}" />
            </Button>
            <TextBox x:Name="AddressBox" Watermark="Remote folder path" VerticalContentAlignment="Center" />
          </DockPanel>
        </Panel>
        <Grid x:Name="Panes" RowDefinitions="*,5,110" >
          <Grid ColumnDefinitions="200,5,*">
            <Border BorderBrush="{DynamicResource RcBorderBrush}" BorderThickness="1" Background="{DynamicResource RcEditorBrush}">
              <TreeView x:Name="FolderTree" Background="Transparent">
                <TreeView.ItemTemplate>
                  <TreeDataTemplate x:DataType="local:FolderNode" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="4" Background="Transparent">
                      <Panel Width="16" Height="16">
                        <Path Data="{StaticResource FolderClosedGeometry}" Fill="{DynamicResource RcAccentBrush}" Stretch="Uniform" IsVisible="{Binding !IsOpen}" />
                        <Path Data="{StaticResource FolderOpenGeometry}" Fill="{DynamicResource RcAccentBrush}" Stretch="Uniform" IsVisible="{Binding IsOpen}" />
                      </Panel>
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    </StackPanel>
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
            </Border>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />
            <Panel Grid.Column="2">
              <Border x:Name="ClassicView" BorderBrush="{DynamicResource RcBorderBrush}" BorderThickness="1" Background="{DynamicResource RcEditorBrush}">
                <DockPanel>
                  <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource RcBorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource RcSurfaceBrush}">
                    <Grid ColumnDefinitions="290,60,70,145,*">
                      <Button x:Name="SortName" Classes="header" Grid.Column="0" Content="Name" />
                      <Button x:Name="SortRights" Classes="header" Grid.Column="1" Content="Rights" />
                      <Button x:Name="SortSize" Classes="header" Grid.Column="2" Content="Size" />
                      <Button x:Name="SortModified" Classes="header" Grid.Column="3" Content="Modified" />
                    </Grid>
                  </Border>
                  <ListBox x:Name="FileList" SelectionMode="Multiple" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="local:FileRow">
                        <Grid ColumnDefinitions="288,60,70,145" Background="Transparent">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <Panel Width="16" Height="16">
                              <Image Source="{Binding Icon}" Width="16" Height="16" IsVisible="{Binding !IsDirectory}" />
                              <Path Data="{StaticResource FolderClosedGeometry}" Fill="{DynamicResource RcAccentBrush}" Stretch="Uniform" IsVisible="{Binding IsDirectory}" />
                            </Panel>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Rights}" Margin="6,0,0,0" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding SizeText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>
              <Border x:Name="ModernHost" IsVisible="False" BorderBrush="{DynamicResource RcBorderBrush}" BorderThickness="1" Background="{DynamicResource RcEditorBrush}">
                <ListBox x:Name="ModernView" SelectionMode="Multiple" Background="Transparent" Padding="8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:ModernItem">
                      <StackPanel Spacing="4" Background="Transparent" ToolTip.Tip="{Binding Name}">
                        <Panel Height="88" HorizontalAlignment="Center">
                          <Path Data="{StaticResource FolderClosedGeometry}" Fill="{DynamicResource RcAccentBrush}" Stretch="Uniform" Width="48" Height="48" IsVisible="{Binding ShowFolderIcon}" />
                          <Image Source="{Binding Image}" Width="{Binding ImageSize}" Height="{Binding ImageSize}" Stretch="Uniform" IsVisible="{Binding ShowImage}" />
                        </Panel>
                        <TextBlock Text="{Binding Name}" TextAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="100" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
              <Border x:Name="DropHint" IsVisible="False" IsHitTestVisible="False" Margin="12" Padding="10,6" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                      Background="{DynamicResource RcSurfaceBrush}" BorderBrush="{DynamicResource RcAccentBrush}" BorderThickness="1" CornerRadius="{DynamicResource RcControlCornerRadius}">
                <TextBlock x:Name="DropHintText" FontWeight="SemiBold" />
              </Border>
            </Panel>
          </Grid>
          <Popup x:Name="PreviewPopup" Placement="Pointer" HorizontalOffset="18" VerticalOffset="18" IsLightDismissEnabled="False" IsHitTestVisible="False">
            <Border Padding="8" BorderThickness="1" Background="{DynamicResource RcSurfaceBrush}" BorderBrush="{DynamicResource RcBorderBrush}">
              <StackPanel Spacing="5">
                <Image x:Name="PreviewImage" Stretch="None" />
                <TextBlock x:Name="PreviewLabel" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" />
              </StackPanel>
            </Border>
          </Popup>
          <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="Transparent" />
          <Border Grid.Row="2" BorderBrush="{DynamicResource RcBorderBrush}" BorderThickness="1">
            <local:LogView x:Name="Log" />
          </Border>
        </Grid>
      </DockPanel>
    </Border>
  </DockPanel>
</rc:RcWindow>
